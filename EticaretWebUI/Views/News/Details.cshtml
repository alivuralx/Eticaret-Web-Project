@model News

@{
    ViewData["Title"] = Model.Name;
}

<h1> @Model.Name </h1>

<div class="row">
	<div class="col-md-6">
		<img src="/Img/@Model.Image" alt="@Model.Image" class="img-fluid" />
	</div>
	<div class="col-md-6">
		@Model.Description
		<p>
			@Model.CreateDate.ToShortDateString()
		</p>
	</div>
</div>
